# Salin ke `.env` lalu isi. JANGAN commit `.env` yang berisi nilai asli.
# Untuk dev lokal dengan DB Vercel: `vercel env pull` (butuh akses project).

# Postgres (Neon / Vercel Storage). Nama var boleh *_DATABASE_URL apa pun — auto-detect di lib/db.js.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Kunci admin: hapus entri leaderboard bogus + baca feedback + trigger manual /api/refresh-all.
# Buat string acak yang panjang, mis: openssl rand -hex 16
ADMIN_KEY=

# Auto-refresh harian (Vercel Cron kirim header `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=

# Notifikasi email feedback via Resend (opsional). Kosongkan kalau tidak dipakai.
RESEND_API_KEY=
FEEDBACK_EMAIL=
# FEEDBACK_FROM=Arcade Hub <onboarding@resend.dev>

# Kode guild default (opsional).
# GUILD_CODE=GCAF26-ID-D4J-QEH
